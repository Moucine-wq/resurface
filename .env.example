# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# server.js lit process.env directement — utilise le gestionnaire de variables d'env
# de ta plateforme de déploiement (Railway/Render ont une section "Variables" dans leur dashboard).

# --- Stripe ---
# Clé secrète : Dashboard Stripe > Developers > API keys > Secret key (commence par sk_live_ ou sk_test_)
STRIPE_SECRET_KEY=sk_live_...

# ID du prix de l'abonnement (9€/mois) : Dashboard Stripe > Product catalog > ton produit > Pricing
# Crée d'abord un produit "Resurface Premium" à 9€/mois récurrent si ce n'est pas déjà fait,
# puis copie l'ID qui commence par price_...
STRIPE_PRICE_ID=price_...

# Secret de signature webhook : Dashboard Stripe > Developers > Webhooks > ton endpoint > Signing secret
# (commence par whsec_...) — voir README pour la procédure de création de l'endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (envoi d'emails) ---
# Crée un compte gratuit sur https://resend.com (100 emails/jour gratuits, largement suffisant pour démarrer)
# puis Dashboard > API Keys > Create API Key
RESEND_API_KEY=re_...

# Adresse d'expédition. Pour commencer sans configurer de domaine, tu peux utiliser :
#   FROM_EMAIL=Resurface <onboarding@resend.dev>
# Pour un envoi pro depuis ton propre domaine (recommandé), vérifie ton domaine dans Resend
# (Domains > Add domain, puis ajoute les enregistrements DNS demandés) et utilise :
#   FROM_EMAIL=Resurface <rappels@tondomaine.com>
FROM_EMAIL=Resurface <onboarding@resend.dev>

# --- App ---
# URL publique de ton app une fois déployée (utilisée dans les emails et les redirections Stripe)
APP_URL=https://resurface.tondomaine.com

# Heure UTC d'envoi du digest quotidien (0-23). 8 = 8h UTC = 9h/10h en France selon la saison.
DIGEST_HOUR_UTC=8

# --- Web Push (VAPID) ---
# Génère une paire de clés avec : npm run generate:vapid
# La clé publique est partagée avec le navigateur, la clé privée reste uniquement sur le serveur.
VAPID_PUBLIC_KEY=BPut-your-base64url-public-key-here
VAPID_PRIVATE_KEY=put-your-base64url-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# Intervalle en millisecondes entre deux exécutions du scheduler Push (défaut : 30000 = 30s)
PUSH_POLL_INTERVAL_MS=30000

# Nombre maximum de tentatives d'envoi Push en cas d'erreur temporaire (défaut : 5)
PUSH_MAX_ATTEMPTS=5

PORT=3000
